# Keep the build context small and never leak local state into the image.
node_modules
dist
coverage
.nyc_output

.git
.gitignore
.gitattributes

.env
.env.*
!.env.example

# Local-only tooling — the image builds from src/ + prisma/ only.
docker-compose.yaml
docker-compose.yml
jest.config.mjs
tsconfig.jest.json
src/tests
**/*.test.ts

.vscode
.idea
.DS_Store
*.log
npm-debug.log*

*.md
LICENSE
