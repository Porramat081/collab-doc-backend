{
  "name": "collab-doc",
  "type": "module",
  "scripts": {
    "start": "node --watch src/app.ts",
    "dev": "node --watch src/app.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:init:mongo": "node src/db/initialize-mongo.ts",
    "migration:create": "migrate-mongo create",
    "migration:compile": "tsc --project tsconfig.json",
    "migration:up": "npm run migration:compile && migrate-mongo up",
    "migration:down": "npm run migration:compile && migrate-mongo down",
    "migration:status": "migrate-mongo status",
    "database:setup": "npm run db:migrate -- --name init && npm run db:init:mongo"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/migrate-mongo": "^10.0.6",
    "@types/node": "^26.4.0",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
