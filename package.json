{
  "name": "collab-doc",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/app.js",
    "dev": "tsx src/app.ts",
    "snapshot:worker": "tsx src/workers/snapshot.worker",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:init:mongo": "tsx src/db/initialize-mongo",
    "migration:create": "migrate-mongo create",
    "migration:compile": "tsc --project tsconfig.json",
    "migration:up": "npm run migration:compile && migrate-mongo up",
    "migration:down": "npm run migration:compile && migrate-mongo down",
    "migration:status": "migrate-mongo status",
    "database:setup": "npm run db:migrate -- --name init && npm run db:init:mongo"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "node-cron": "^4.6.0",
    "tsx": "^4.23.13",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/migrate-mongo": "^10.0.6",
    "@types/node": "^26.4.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "jest": "^30.5.0",
    "prisma": "^6.12.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.3",
    "typescript": "^6.0.3"
  },
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
