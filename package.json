{
  "name": "collab-doc",
  "version": "1.0.0",
  "description": "Collaborative document backend (Express + Yjs over WebSocket, PostgreSQL + MongoDB + Redis)",
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:init:mongo": "node dist/db/initialize-mongo.js",
    "db:init:mongo:dev": "tsx src/db/initialize-mongo.ts",
    "database:setup": "npm run db:migrate -- --name init && npm run db:init:mongo:dev",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "node-cron": "^4.6.0",
    "prisma": "^6.12.0",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/migrate-mongo": "^10.0.6",
    "@types/node": "^26.4.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "jest": "^30.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
